				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "70085408-e08a-425a-aefe-a1c93cfbefe8")
	)
	(text_box "DESIGN NOTE:\n5V BUCK\nVout = 1.0 x (1 + R12/R10) \n     = 1.0 x (1 + 100k/24.9k) = 5.016 V\ndIL  = Vout(Vin-Vout)/(Vin x L x fsw)\n     = 5(50.4-5)/(50.4 x 10u x 400k) = 1.13 A pk-pk\nIpk  = Iout + 0.56 A. L2 sat 3.2 A -> OK to 2.6 A load.\nCin(eff): 2 x 4u7 X7R 1210 at 50 V DC bias ~= 40% -> ~3.8 uF\nCout(eff): 4 x 22u X5R 0805 at 5 V DC bias ~= 70% -> ~62 uF"
		(exclude_from_sim no)
		(at 313.69 86.1587 0)
		(size 60.96 25.6013)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0.508)
			(type solid)
			(color 0 0 255 1)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "7ba19019-21e6-4180-bc16-5e5f29d91fa0")
	)
	(text_box "DESIGN NOTE:\n3V3 BUDGET AND LDO THERMAL\nPd = (5.02 - 3.30) x I = 1.72 x 500mA = 0.86 W\nTheta-JA (WSON-6, 2 oz, thermal pad vias) ~= 78 C/W\ndT = 67 C. Tj at 25 C ambient = 92 C. Limit 125 C.\n\nRequire external heatsink if operating in warm ambient"
		(exclude_from_sim no)
		(at 146.05 181.6101 0)
		(size 45.72 25.3999)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0.508)
			(type solid)
			(color 0 0 255 1)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
