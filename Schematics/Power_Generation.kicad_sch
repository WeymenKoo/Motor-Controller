		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "3f71d9f0-574e-42ed-aa7a-665c4e7abb2d")
	)
	(text_box "DESIGN NOTE:\nEN gated on PG_5V -> 3V3 cannot precede 5V."
		(exclude_from_sim no)
		(at 78.74 209.55 0)
		(size 22.86 11.43)
		(margins 0.9525 0.9525 0.9525 0.9525)
