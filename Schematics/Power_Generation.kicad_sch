	(text_box "SPEC:\nTLV75733PDRV   TI   \nWSON-6 2x2 (DRV)\nVin 2.5-5.5 V \n1 A \nVdo ~240 mV @ 1 A \nfixed 3.3 V\nEN gated on PG_5V -> 3V3 cannot precede 5V."
		(exclude_from_sim no)
		(at 146.05 210.8347 0)
		(size 27.94 21.5753)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0.508)
			(type solid)
			(color 0 194 0 1)
