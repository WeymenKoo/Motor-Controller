	(text_box "DESIGN NOTE:\nCALC - 10K NTC ON-BOARD NCP18XH103J03RB\n  V = 3.3 x R38/(NTC + R38)\n    -10 C (~42k)  -> 0.63 V\n     25 C (10k)   -> 1.65 V\n    100 C (~680R) -> 3.09 V\n  Self-heat: I = 165 uA, P = 0.27 mW, <0.1 C rise. Negligible."
		(exclude_from_sim no)
		(at 30.48 92.71 0)
		(size 43.18 21.59)
		(margins 0.9525 0.9525 0.9525 0.9525)
