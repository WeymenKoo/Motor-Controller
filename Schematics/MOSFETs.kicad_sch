	(text_box "DESIGN NOTE:\nCALC - CONDUCTION LOSS\n  Rds(on) at Tj 125 C ~= 3.0 mR x 1.5 = 4.5 mR\n  P_cond = 3 x Iph_rms^2 x Rds(on) = 3 x [FILL]^2 x 4.5 mR = [FILL] W\n  Shunt   P = Iph_rms^2 x 3 mR = [FILL] W each (3 W rated)\n  Vsense at 20 A = 60 mV"
		(exclude_from_sim no)
		(at 135.89 220.98 0)
